// Deploy config for Cloudflare Workers Static Assets. Without this file `wrangler deploy` treats the project as
// unconfigured and runs its interactive setup, which tries to inject a plugin into vite.config.ts and fails on a
// config that has no plugins array — that is what broke the first deploy.
//
// The worker handles the authenticated custom-object API and delegates every other request to the same static
// assets binding. `single-page-application` keeps direct room addresses working.
{
  "name": "roomer",
  "compatibility_date": "2026-08-17",
  "main": "src/worker.ts",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "OPENAI_MODEL": "gpt-5-mini"
  },
  "observability": {
    "enabled": true
  }
}
