// Deploy config for Cloudflare Workers Static Assets. Without this file `wrangler deploy` treats the project as
// unconfigured and runs its interactive setup, which tries to inject a plugin into vite.config.ts and fails on a
// config that has no plugins array — that is what broke the first deploy.
//
// There is no `main`, so this is an assets-only Worker: it just serves ./dist. `single-page-application` is the
// Workers equivalent of the SPA fallback, so a room address like /gyuh returns index.html instead of a 404 and
// social.ts can read the handle straight off location.pathname.
{
  "name": "roomer",
  "compatibility_date": "2026-08-17",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
